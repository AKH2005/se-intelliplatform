# ==============================================================================
# SE INTELLIPLATFORM - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to backend/.env and configure for your local environment.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Application Configuration
PROJECT_NAME="SE IntelliPlatform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with async psycopg driver)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=se_intelliplatform

# Computed Database URL (Can be overridden directly)
DATABASE_URL=postgresql+psycopg://postgres:postgres_password@localhost:5432/se_intelliplatform

# LLM Provider Configuration
# Supported options: mock, groq, gemini
LLM_PROVIDER=groq
LLM_MODEL=mock-model-v1
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=3

# Groq Cloud API Key
GROQ_API_KEY=

# Google Gemini API Key
GEMINI_API_KEY=

# Redis Infrastructure Configuration (Phase 2+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
