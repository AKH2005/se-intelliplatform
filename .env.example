# ==============================================================================
# SE INTELLIPLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure for your deployment or local environment.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Application Configuration
PROJECT_NAME="SE IntelliPlatform"
ENVIRONMENT="development"
DEBUG=false
API_V1_STR="/api/v1"
PORT=8000

# Security & Authentication (JWT Secret)
# In production, generate a secure random 32+ character key:
# e.g., openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment URL):
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
# Regex pattern for preview deployments (e.g. Vercel preview branches):
CORS_ORIGIN_REGEX="^https:\/\/.*\.vercel\.app$"

# Application Live Preview Runtime
# In local development: http://127.0.0.1:8001/
# In cloud deployment: URL where the preview server is hosted (if deployed separately)
PREVIEW_RUNTIME_URL="http://127.0.0.1:8001/"

# Database Configuration (PostgreSQL with async psycopg driver)
# For local development with Docker:
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="se_intelliplatform"

# Computed / Direct Database URL (Preferred for Render, Neon, Supabase)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# Note: For SQLite local development, leave unset or use: sqlite+aiosqlite:///se_intelliplatform.db
DATABASE_URL="postgresql+psycopg://postgres:postgres_password@localhost:5432/se_intelliplatform"

# Redis Infrastructure Configuration (Optional)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# LLM Provider Configuration (Vendor-neutral AI infrastructure)
# Supported options: mock, groq, gemini
LLM_PROVIDER="groq"
LLM_MODEL="openai/gpt-oss-20b"
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=3

# Groq Cloud API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=""

# Google Gemini API Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=""

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="json"
