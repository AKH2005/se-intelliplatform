# ==============================================================================
# SE INTELLIPLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure for your local development environment.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Application Configuration
PROJECT_NAME="SE IntelliPlatform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with async psycopg driver)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=se_intelliplatform

# Computed Database URL (Can be overridden directly)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres_password@localhost:5432/se_intelliplatform

# Redis Infrastructure Configuration (Prepared for Phase 2+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
